# ============================================
# CINETPAY PAYMENT GATEWAY CONFIGURATION
# ============================================
# Obtenez vos clés sur: https://cinetpay.com
# Documentation: https://docs.cinetpay.com

# CinetPay API Keys
CINETPAY_API_KEY=your_cinetpay_api_key_here
CINETPAY_SITE_ID=your_site_id_here
CINETPAY_SECRET_KEY=your_secret_key_here
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2
CINETPAY_NOTIFY_URL="${APP_URL}/payment/cinetpay/notify"

# ============================================
# SMS VERIFICATION CONFIGURATION
# ============================================

# SMS Provider (smsup or twilio)
SMS_PROVIDER=smsup

# SMSUP Configuration (Côte d'Ivoire)
# Obtenez votre token sur: https://www.smsup.ci
SMSUP_TOKEN=your_smsup_token_here
SMSUP_SENDER=CarrePremium

# Twilio Configuration (Alternative)
# Obtenez vos clés sur: https://www.twilio.com
TWILIO_SID=your_twilio_sid_here
TWILIO_TOKEN=your_twilio_token_here
TWILIO_FROM=+1234567890

# ============================================
# TRANSLATION API CONFIGURATION
# ============================================

# Translation Provider (google or libretranslate)
TRANSLATION_PROVIDER=google

# Google Translate API
# Obtenez votre clé sur: https://cloud.google.com/translate
GOOGLE_TRANSLATE_API_KEY=your_google_translate_api_key_here

# LibreTranslate (Free Alternative)
# API gratuite: https://libretranslate.de
LIBRETRANSLATE_API_URL=https://libretranslate.de
LIBRETRANSLATE_API_KEY=

# ============================================
# EMAIL CONFIGURATION FOR PRODUCTION
# ============================================

# Mailgun (Recommended for production)
MAIL_MAILER=mailgun
MAILGUN_DOMAIN=your_domain.com
MAILGUN_SECRET=your_mailgun_secret_here
MAILGUN_ENDPOINT=api.eu.mailgun.net

# SendGrid (Alternative)
# MAIL_MAILER=sendgrid
# SENDGRID_API_KEY=your_sendgrid_api_key_here

# SMTP (Alternative)
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.mailtrap.io
# MAIL_PORT=2525
# MAIL_USERNAME=your_username
# MAIL_PASSWORD=your_password
# MAIL_ENCRYPTION=tls

MAIL_FROM_ADDRESS="noreply@carrepremium.ci"
MAIL_FROM_NAME="${APP_NAME}"

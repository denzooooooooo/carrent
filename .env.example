# Duffel API v2 Configuration
# Get your API key from: https://app.duffel.com/
DUFFEL_KEY=duffel_live_xxx

# Webhook Secret for verifying incoming webhooks
# Generate this in your Duffel dashboard under Webhooks
DUFFEL_WEBHOOK_SECRET=whsec_xxx

# API Version - Always use v2 for latest features
DUFFEL_VERSION=v2

# Request timeout in seconds
DUFFEL_TIMEOUT=30

# Use mock data for development/testing (set to false for production)
DUFFEL_USE_MOCK=true

# Retry configuration for failed API calls
DUFFEL_MAX_RETRIES=3
DUFFEL_RETRY_DELAY=1000

# Commission rates by cabin class (in percentage)
# Economy: 15%, Business: 12%, First: 10%
DUFFEL_ECONOMY_COMMISSION=15
DUFFEL_BUSINESS_COMMISSION=12
DUFFEL_FIRST_COMMISSION=10

# Currency conversion rate (EUR to XOF)
# Update this regularly based on current exchange rates
EUR_TO_XOF_RATE=655.957

# Payment gateway configurations
CINETPAY_API_KEY=5989703936954f926684b86.84276358
CINETPAY_SITE_ID=105907298
CINETPAY_SECRET_KEY=13387684866954faf0441c83.89986251
CINETPAY_BASE_URL=https://api-checkout.cinetpay.com/v2

# CyberSource payment gateway (alternative)
CYBERSOURCE_MERCHANT_ID=your_merchant_id
CYBERSOURCE_API_KEY_ID=your_api_key_id
CYBERSOURCE_SECRET_KEY=your_secret_key
CYBERSOURCE_ENVIRONMENT=test

# Email service configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@carrepremium.ci
MAIL_FROM_NAME="Carré Premium"

# Alternative email services
SENDGRID_API_KEY=your_sendgrid_api_key
MAILTRAP_API_TOKEN=your_mailtrap_api_token

# SMS service configuration
SMS_PROVIDER=smsup
SMSUP_TOKEN=your_smsup_token
SMSUP_SENDER=CarréPremium

# Alternative SMS service
TWILIO_SID=your_twilio_sid
TWILIO_TOKEN=your_twilio_token
TWILIO_FROM=your_twilio_number

# Translation service
TRANSLATION_PROVIDER=libretranslate
LIBRETRANSLATE_API_URL=https://libretranslate.de
LIBRETRANSLATE_API_KEY=

# Google Translate (alternative)
GOOGLE_TRANSLATE_API_KEY=your_google_translate_key

# Social authentication
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=https://carrepremium.ci/auth/google/callback

FACEBOOK_CLIENT_ID=your_facebook_client_id
FACEBOOK_CLIENT_SECRET=your_facebook_client_secret
FACEBOOK_REDIRECT_URL=https://carrepremium.ci/auth/facebook/callback

# Database configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=carrepremium
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# Application configuration
APP_NAME="Carré Premium"
APP_ENV=production
APP_KEY=base64:your_app_key_here
APP_DEBUG=false
APP_URL=https://carrepremium.ci

# Public contact information
CARRE_PREMIUM_CONTACT_EMAIL=infos@carrepremium.com
CARRE_PREMIUM_SUPPORT_EMAIL=infos@carrepremium.com
CARRE_PREMIUM_BILLING_EMAIL=infos@carrepremium.com
CARRE_PREMIUM_MOBILE_DISPLAY="+225 01 01 22 15 15"
CARRE_PREMIUM_MOBILE_LINK=tel:+2250101221515
CARRE_PREMIUM_LANDLINE_DISPLAY="+225 27 21 59 42 58"
CARRE_PREMIUM_LANDLINE_LINK=tel:+2252721594258
CARRE_PREMIUM_WHATSAPP_DISPLAY="+225 01 01 22 15 15"
CARRE_PREMIUM_WHATSAPP_URL=https://wa.me/2250101221515

# Cache and session configuration
CACHE_DRIVER=file
SESSION_DRIVER=file
SESSION_LIFETIME=120

# Queue configuration (for background processing)
QUEUE_CONNECTION=database

# File storage
FILESYSTEM_DISK=local

# Logging
LOG_CHANNEL=stack
LOG_LEVEL=error

# Timezone
APP_TIMEZONE=Africa/Abidjan
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

# Maintenance mode
APP_MAINTENANCE_MODE=false

# Security
SANCTUM_STATEFUL_DOMAINS=carrepremium.ci,www.carrepremium.ci

# Performance optimization
OPCACHE_ENABLE=true
JIT_ENABLE=true

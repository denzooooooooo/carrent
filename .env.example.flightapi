# ===========================================
# FLIGHTAPI CONFIGURATION - SYSTÈME COMPLET
# ===========================================

# FlightAPI - Réservations de vols complètes
# API Key: 695e787ff5a1c15002cad75e
FLIGHTAPI_KEY=695e787ff5a1c15002cad75e
FLIGHTAPI_URL=https://api.flightapi.io
FLIGHTAPI_TIMEOUT=30

# ===========================================
# AUTRES APIs (pour fallback)
# ===========================================

# AviationEdge (fallback pour données de routes)
AVIATION_EDGE_KEY=0578e4-e1db1c
AVIATION_EDGE_URL=https://aviation-edge.com/v2

# Duffel (alternative pour prix réels)
DUFFEL_KEY=votre_cle_duffel_si_disponible

# ===========================================
# INSTRUCTIONS D'INSTALLATION
# ===========================================

# 1. Copiez ces variables dans votre fichier .env
# 2. Redémarrez votre serveur Laravel
# 3. Testez avec: php artisan tinker
#    $api = app(\App\Services\FlightAPIService::class);
#    $result = $api->searchFlights('CDG', 'JFK', '2024-02-15');

# ===========================================
# CAPACITÉS FLIGHTAPI
# ===========================================

# ✅ Recherche de vols avec prix réels TTC
# ✅ Réservations instantanées
# ✅ Émission de billets électroniques
# ✅ Gestion complète des passagers
# ✅ Paiement intégré
# ✅ Support multi-compagnies aériennes
# ✅ Multi-devises (XOF, EUR, USD)

# ===========================================
# WORKFLOW COMPLET
# ===========================================

# 1. Recherche → Prix TTC affichés
# 2. Réservation → PNR généré
# 3. Paiement → Via CinetPay/Cybersource
# 4. Confirmation → Email avec e-ticket
# 5. Suivi → Dashboard client

# ===========================================
# REVENUS POSSIBLES
# ===========================================

# - Commission par réservation (markup)
# - Frais de service fixes
# - Assurance voyage optionnelle
# - Services additionnels (sièges premium, bagages)

# Exemple: Vol 450€ → Votre prix 500€ → Profit 50€

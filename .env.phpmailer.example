# ============================================
# PHPMailer Configuration pour Carré Premium
# ============================================

# Configuration SMTP
PHPMAILER_HOST=smtp.gmail.com
PHPMAILER_PORT=587
PHPMAILER_USERNAME=votre-email@gmail.com
PHPMAILER_PASSWORD=xxxx xxxx xxxx xxxx
PHPMAILER_ENCRYPTION=tls

# Informations de l'expéditeur
PHPMAILER_FROM_ADDRESS=noreply@carrepremium.ci
PHPMAILER_FROM_NAME="Carré Premium"

# ============================================
# Options de Configuration
# ============================================

# Option 1: Gmail (Tests)
# - Activez l'authentification à 2 facteurs
# - Générez un mot de passe d'application: https://myaccount.google.com/apppasswords
# PHPMAILER_HOST=smtp.gmail.com
# PHPMAILER_PORT=587
# PHPMAILER_USERNAME=votre-email@gmail.com
# PHPMAILER_PASSWORD=mot-de-passe-application-16-caracteres
# PHPMAILER_ENCRYPTION=tls

# Option 2: Mailtrap (Tests en développement)
# - Créez un compte sur https://mailtrap.io
# PHPMAILER_HOST=sandbox.smtp.mailtrap.io
# PHPMAILER_PORT=2525
# PHPMAILER_USERNAME=votre-username-mailtrap
# PHPMAILER_PASSWORD=votre-password-mailtrap
# PHPMAILER_ENCRYPTION=tls

# Option 3: SendGrid (Production)
# - Créez un compte sur https://sendgrid.com
# - Créez une API Key
# PHPMAILER_HOST=smtp.sendgrid.net
# PHPMAILER_PORT=587
# PHPMAILER_USERNAME=apikey
# PHPMAILER_PASSWORD=SG.votre-api-key-sendgrid
# PHPMAILER_ENCRYPTION=tls

# Option 4: SMTP Local (Côte d'Ivoire)
# PHPMAILER_HOST=mail.votredomaine.ci
# PHPMAILER_PORT=587
# PHPMAILER_USERNAME=noreply@carrepremium.ci
# PHPMAILER_PASSWORD=votre-mot-de-passe
# PHPMAILER_ENCRYPTION=tls

# ============================================
# Instructions
# ============================================
# 1. Copiez les variables ci-dessus dans votre fichier .env
# 2. Choisissez une option de configuration
# 3. Remplacez les valeurs par vos credentials
# 4. Testez avec: php test-phpmailer.php votre-email@example.com
# 5. Consultez PHPMAILER_QUICK_START.md pour plus d'informations
